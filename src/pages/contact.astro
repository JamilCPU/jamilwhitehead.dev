---
import Container from "../components/layouts/Container.astro";
import PageTitle from "../components/ui/PageTitle.astro";
import SocialLinks from "../components/ui/SocialLinks.astro";
import Link from "../components/ui/link/Link.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Contact"
    description="Get in touch with Jamil Whitehead."
>
    <Container class="mx-auto max-w-2xl py-12">
        <PageTitle title="Get in Touch" />

        <div class="mt-10 space-y-8">
            <p class="text-lg text-gray-700 dark:text-gray-300">
                Want to chat, collaborate, or just say hi? Reach out through any of the channels below.
            </p>

            <div class="space-y-4">
                <div class="flex items-center gap-3">
                    <span class="text-sm font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 w-20">Email</span>
                    <Link href="mailto:jamilw284@gmail.com" variant="default">
                        jamilw284@gmail.com
                    </Link>
                </div>

                <div class="flex items-center gap-3">
                    <span class="text-sm font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 w-20">LinkedIn</span>
                    <Link href="https://www.linkedin.com/in/jamil-whitehead-software-engineering/" variant="default">
                        Jamil Whitehead
                    </Link>
                </div>

                <div class="flex items-center gap-3">
                    <span class="text-sm font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 w-20">GitHub</span>
                    <Link href="https://github.com/JamilCPU" variant="default">
                        JamilCPU
                    </Link>
                </div>
            </div>

            <div class="pt-4 border-t border-gray-200 dark:border-gray-700">
                <SocialLinks class="mt-4" appearance="chip" />
            </div>
        </div>
    </Container>
</BaseLayout>
