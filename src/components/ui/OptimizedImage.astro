---
import { cn } from "../../utils/styles";

interface Props {
    src: string;
    alt: string;
    width?: number;
    height?: number;
    wrapperClass?: string;
    imageClass?: string;
    loading?: "lazy" | "eager";
    fetchpriority?: "high" | "low" | "auto";
    [key: string]: unknown;
}

const {
    src,
    alt,
    wrapperClass = "",
    imageClass = "",
    loading = "lazy",
    fetchpriority,
    width,
    height,
    ...rest
} = Astro.props;

const fetchPriorityVal =
    loading === "eager" ? (fetchpriority ?? "high") : undefined;
---

<div
    class={cn(
        "relative overflow-hidden bg-neutral-200 dark:bg-neutral-700",
        wrapperClass,
    )}
>
    <img
        src={src}
        alt={alt}
        width={width}
        height={height}
        class={cn("absolute inset-0 h-full w-full object-cover", imageClass)}
        loading={loading}
        fetchpriority={fetchPriorityVal}
        decoding="async"
    />
</div>
